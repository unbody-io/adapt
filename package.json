{
  "name": "@unbody-io/adapt",
  "version": "0.0.1",
  "description": "A self-evolving memory layer for AI applications",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./sqlite": {
      "import": "./dist/sqlite.js",
      "types": "./dist/sqlite.d.ts"
    }
  },
  "scripts": {
    "build": "tsc && tsc-alias -f",
    "dev": "tsc --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "eval:text-neuron": "npx tsx evals/scripts/text-neuron-semantic-eval.ts",
    "eval:list-neuron": "npx tsx evals/scripts/list-neuron-semantic-eval.ts",
    "eval:behavior-brain": "npx tsx evals/scripts/usecase-behavior-brain.ts",
    "test:store": "npx tsx tests/store-standalone.ts",
    "test:docs": "npx tsx tests/docs-code/run-all.ts",
    "docs:dev": "cd website && npm run dev",
    "docs:build": "cd website && npm run build"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "keywords": [
    "unbody",
    "adapt",
    "memory",
    "neurons",
    "ai"
  ],
  "license": "MIT",
  "devDependencies": {
    "@ai-sdk/openai-compatible": "^2.0.35",
    "@biomejs/biome": "^2.3.13",
    "@openrouter/ai-sdk-provider": "^2.1.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "ai": "^6.0.0",
    "nanoid": "^5.1.6",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "better-sqlite3": "^12.6.2"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": true
    }
  }
}
