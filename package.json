{
  "name": "@unbody/adapt",
  "version": "0.0.1",
  "description": "A self-evolving memory layer for AI applications",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./sqlite": {
      "import": "./dist/sqlite.js",
      "types": "./dist/sqlite.d.ts"
    }
  },
  "scripts": {
    "build": "tsc && tsc-alias -f",
    "dev": "tsc --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "eval": "bun evals/run-eval.ts",
    "eval:crisis": "bun evals/run-eval.ts crisis-hostage",
    "eval:developer": "bun evals/run-eval.ts developer-memory",
    "eval:therapist": "bun evals/run-eval.ts therapist-profile",
    "eval:neuron": "bun evals/neuron.eval.ts",
    "eval:neuron:list": "bun evals/neuron.eval.ts --list",
    "eval:living:neuron-01": "bun evals/scripts/neuron-01-lifecycle.ts",
    "eval:living:neuron-02": "bun evals/scripts/neuron-02-update.ts",
    "eval:living:neuron-03": "bun evals/scripts/neuron-03-learn.ts",
    "eval:living:neuron-04": "bun evals/scripts/neuron-04-query.ts",
    "eval:living:neuron-05": "bun evals/scripts/neuron-05-signal-dismissal.ts",
    "eval:living:neuron-06": "bun evals/scripts/neuron-06-signal-confidence.ts",
    "eval:living:neuron-07": "bun evals/scripts/neuron-07-signal-buffer.ts",
    "eval:living:neuron-08": "bun evals/scripts/neuron-08-signal-stagnation.ts",
    "eval:living:neuron-09": "bun evals/scripts/neuron-09-comprehensive-update.ts",
    "eval:living:brain-01": "bun evals/scripts/brain-01-initialization.ts",
    "eval:living:brain-02": "bun evals/scripts/brain-02-signal-buffering.ts",
    "eval:living:brain-03": "bun evals/scripts/brain-03-manual-create.ts",
    "eval:living:brain-04": "bun evals/scripts/brain-04-manual-merge.ts",
    "eval:living:brain-05": "bun evals/scripts/brain-05-manual-split.ts",
    "eval:living:brain-06": "bun evals/scripts/brain-06-manual-update.ts",
    "eval:living:brain-07": "bun evals/scripts/brain-07-manual-delete.ts",
    "eval:living:brain-08": "bun evals/scripts/brain-08-brain-update.ts",
    "eval:living:phase1": "bun evals/scripts/neuron-01-lifecycle.ts && bun evals/scripts/neuron-02-update.ts && bun evals/scripts/neuron-03-learn.ts && bun evals/scripts/neuron-04-query.ts && bun evals/scripts/brain-01-initialization.ts && bun evals/scripts/brain-03-manual-create.ts",
    "eval:living:phase2": "bun evals/scripts/neuron-05-signal-dismissal.ts && bun evals/scripts/neuron-06-signal-confidence.ts && bun evals/scripts/neuron-07-signal-buffer.ts && bun evals/scripts/neuron-08-signal-stagnation.ts && bun evals/scripts/brain-02-signal-buffering.ts && bun evals/scripts/brain-04-manual-merge.ts && bun evals/scripts/brain-05-manual-split.ts && bun evals/scripts/brain-06-manual-update.ts && bun evals/scripts/brain-07-manual-delete.ts && bun evals/scripts/brain-08-brain-update.ts"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "unbody",
    "adapt",
    "memory",
    "neurons",
    "ai"
  ],
  "license": "MIT",
  "devDependencies": {
    "@ai-sdk/openai-compatible": "^2.0.35",
    "@biomejs/biome": "^2.3.13",
    "@openrouter/ai-sdk-provider": "^2.1.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "ai": "^6.0.0",
    "nanoid": "^5.1.6",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "better-sqlite3": "^12.6.2"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": true
    }
  }
}
