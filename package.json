{
  "name": "@unbody/brain",
  "version": "0.0.1",
  "description": "Unbody Brain - Learning agents that build understanding over time",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "eval": "bun evals/run-eval.ts",
    "eval:crisis": "bun evals/run-eval.ts crisis-hostage",
    "eval:developer": "bun evals/run-eval.ts developer-memory",
    "eval:therapist": "bun evals/run-eval.ts therapist-profile",
    "eval:learner": "bun evals/learner.eval.ts",
    "eval:learner:list": "bun evals/learner.eval.ts --list",
    "eval:living:learner-01": "bun evals/scripts/learner-01-lifecycle.ts",
    "eval:living:learner-02": "bun evals/scripts/learner-02-update.ts",
    "eval:living:learner-03": "bun evals/scripts/learner-03-learn.ts",
    "eval:living:learner-04": "bun evals/scripts/learner-04-query.ts",
    "eval:living:learner-05": "bun evals/scripts/learner-05-signal-dismissal.ts",
    "eval:living:learner-06": "bun evals/scripts/learner-06-signal-confidence.ts",
    "eval:living:learner-07": "bun evals/scripts/learner-07-signal-buffer.ts",
    "eval:living:learner-08": "bun evals/scripts/learner-08-signal-stagnation.ts",
    "eval:living:brain-01": "bun evals/scripts/brain-01-initialization.ts",
    "eval:living:brain-02": "bun evals/scripts/brain-02-signal-buffering.ts",
    "eval:living:brain-03": "bun evals/scripts/brain-03-manual-create.ts",
    "eval:living:brain-04": "bun evals/scripts/brain-04-manual-merge.ts",
    "eval:living:brain-05": "bun evals/scripts/brain-05-manual-split.ts",
    "eval:living:brain-06": "bun evals/scripts/brain-06-manual-update.ts",
    "eval:living:brain-07": "bun evals/scripts/brain-07-manual-delete.ts",
    "eval:living:brain-08": "bun evals/scripts/brain-08-brain-update.ts",
    "eval:living:phase1": "bun evals/scripts/learner-01-lifecycle.ts && bun evals/scripts/learner-02-update.ts && bun evals/scripts/learner-03-learn.ts && bun evals/scripts/learner-04-query.ts && bun evals/scripts/brain-01-initialization.ts && bun evals/scripts/brain-03-manual-create.ts",
    "eval:living:phase2": "bun evals/scripts/learner-05-signal-dismissal.ts && bun evals/scripts/learner-06-signal-confidence.ts && bun evals/scripts/learner-07-signal-buffer.ts && bun evals/scripts/learner-08-signal-stagnation.ts && bun evals/scripts/brain-02-signal-buffering.ts && bun evals/scripts/brain-04-manual-merge.ts && bun evals/scripts/brain-05-manual-split.ts && bun evals/scripts/brain-06-manual-update.ts && bun evals/scripts/brain-07-manual-delete.ts && bun evals/scripts/brain-08-brain-update.ts",
    "server": "bun server/index.ts",
    "server:dev": "bun --watch server/index.ts"
  },
  "keywords": [
    "unbody",
    "brain",
    "learning",
    "agents"
  ],
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.3.13",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@openrouter/ai-sdk-provider": "^2.1.1",
    "ai": "^6.0.0",
    "hono": "^4.11.7",
    "nanoid": "^5.1.6",
    "zod": "^3.24.0"
  },
  "peerDependencies": {
    "ai": "^6.0.0"
  }
}
