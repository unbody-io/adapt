{
  "name": "@unbody-io/adapt",
  "version": "0.0.5",
  "description": "A self-evolving memory layer for AI applications",
  "type": "module",
  "main": "dist-cjs/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist-cjs/index.js"
    },
    "./sqlite": {
      "types": "./dist/sqlite.d.ts",
      "import": "./dist/sqlite.js",
      "require": "./dist-cjs/sqlite.js"
    },
    "./sqlite/bun": {
      "types": "./dist/sqlite/bun.d.ts",
      "import": "./dist/sqlite/bun.js"
    }
  },
  "scripts": {
    "build": "npm run build:esm && npm run build:cjs",
    "build:esm": "tsc && tsc-alias -f",
    "build:cjs": "tsc -p tsconfig.cjs.json && tsc-alias -f -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist-cjs/package.json', JSON.stringify({type:'commonjs'}, null, 2) + '\\n')\"",
    "dev": "tsc --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "format": "biome format --write src",
    "eval:text-neuron": "npx tsx evals/scripts/text-neuron-semantic-eval.ts",
    "eval:list-neuron": "npx tsx evals/scripts/list-neuron-semantic-eval.ts",
    "eval:behavior-brain": "npx tsx evals/scripts/usecase-behavior-brain.ts",
    "eval:behavior-brain:bun": "bun run evals/scripts/usecase-behavior-brain.ts",
    "test:store": "vitest run tests/store-standalone.test.ts",
    "test:store:bun": "bun test tests/store-bun.bun.test.ts",
    "test:package-smoke": "node tests/package-smoke.mjs",
    "test:release:store": "npx tsc --noEmit && npm run build && npm run test:store && npm run test:store:bun && npx vitest run tests/store-persistence.test.ts && bun test tests/store-persistence.bun.test.ts && npx vitest run tests/brain-restore-smoke.test.ts && bun test tests/brain-restore-smoke.bun.test.ts && npm run test:package-smoke",
    "test:docs": "npm run build && npx tsx tests/docs-code/run-all.ts",
    "docs:dev": "cd website && npm run dev",
    "docs:build": "cd website && npm run build"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist-cjs/**/*.js",
    "dist-cjs/package.json"
  ],
  "keywords": [
    "unbody",
    "adapt",
    "memory",
    "neurons",
    "ai"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unbody-io/adapt.git"
  },
  "homepage": "https://adapt.unbody.io",
  "bugs": "https://github.com/unbody-io/adapt/issues",
  "author": "Unbody <hello@unbody.io> (https://unbody.io)",
  "license": "MIT",
  "devDependencies": {
    "@ai-sdk/anthropic": "^3.0.74",
    "@ai-sdk/google": "^3.0.67",
    "@ai-sdk/openai": "^3.0.58",
    "@ai-sdk/openai-compatible": "^2.0.35",
    "@ai-sdk/togetherai": "^2.0.49",
    "@biomejs/biome": "^2.3.13",
    "@openrouter/ai-sdk-provider": "^2.1.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "ai": "^6.0.0",
    "jsonrepair": "^3.14.0",
    "nanoid": "^5.1.6",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "better-sqlite3": "^12.6.2"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": true
    }
  }
}
